# Copy to `.env` and fill in. Never commit the real file.
#
# Multi-tenant notes:
#   - All club data is isolated by PostgreSQL row level security, driven by the
#     `app.club_id` / `app.platform_mode` settings that config/db.js sets on the
#     connection inside each request's transaction. There is nothing to switch
#     off here - isolation is enforced by the database.
#   - The two sign-ins are independent: Google for people who buy the software,
#     email + password for the members and staff who join a club.

PORT=5000

# Neon Postgres (primary database). `npm run db:init` creates the schema and
# runs db/migrations/*.sql in filename order.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the club-scoped and platform JWTs.
JWT_SECRET=change-this-to-a-long-random-string

# The role every club-scoped transaction switches into (see
# db/migrations/003_tenant_app_role.sql). It is created automatically on boot.
# It must NOT carry BYPASSRLS: Neon grants that to the owner role, and a role
# with the privilege ignores row level security entirely. Defaults to scms_app.
# TENANT_DB_ROLE=scms_app

# --- Google sign-in (club owners) ---------------------------------------------
# Only needed here. The front end reads the id from GET /api/public/config, so
# there is no VITE_ variable to keep in sync. To get one: Google Cloud Console
# -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID ->
# Web application, with http://localhost:5173 as an authorized JavaScript
# origin (no trailing slash, no redirect URI needed).
# Leave empty to run without Google: the sign-in screens show a config notice
# and email + password keeps working.
GOOGLE_CLIENT_ID=

# --- Platform owner (the software's own admin) --------------------------------
# Comma separated allow-list. These accounts are created/refreshed on boot with
# Role = 'super_admin' and can open the /platform console.
PLATFORM_ADMIN_EMAILS=owner@example.com

# Optional fallback password for the platform console, used only until Google
# sign-in is configured. Leave empty to force Google-only access.
PLATFORM_ADMIN_PASSWORD=

# --- Storage (optional) -------------------------------------------------------
# Set these to keep payment receipts and avatars on Cloudinary instead of the
# local uploads/ folder (which is ephemeral on Vercel).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Legacy SQL Server (only the one-off migration scripts) -------------------
# DB_SERVER=
# DB_NAME=

# Frontend origins allowed by CORS, comma separated.
# CORS_ORIGINS=https://your-site.vercel.app,http://localhost:5173
